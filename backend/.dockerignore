# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Env / secrets — never bake into the image
.env
.env.*
!.env.example

# Local runtime data / scratch (NOT app code)
*.log
data/cache/
data/oews/
scratchpad/
tmp/

# VCS / editor / OS
.git/
.gitignore
.vscode/
.idea/
.DS_Store

# Tests (not needed at runtime)
tests/

# NOTE: do NOT blanket-exclude *.md or *.csv — the agno skills ship SKILL.md +
# references/*.md (agent/skills/**), and dropping them breaks LocalSkills(validate=True).
