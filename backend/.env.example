# Collecct backend — copy to .env and fill in. Never commit .env.

# --- MongoDB (the CRM / pipeline source of truth) ---
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=collecct

# --- OpenRouter (agent model + Excel column-mapping LLM) ---  REQUIRED to ingest & run agents
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EXTRACTION_MODEL=google/gemini-3.1-flash-lite      # used by Excel ingestion
ANALYST_MODEL=anthropic/claude-sonnet-4.6          # used by the agents (via the cached LLM client)

# --- Exa (web search tool for agents) ---  REQUIRED for Analyst/Capture research
EXA_API_KEY=

# --- iDrive e2 (S3-compatible storage for generated documents) ---  REQUIRED for doc generation
IDRIVE_E2_ENDPOINT=
IDRIVE_E2_ACCESS_KEY=
IDRIVE_E2_SECRET_KEY=
IDRIVE_E2_BUCKET=

# --- Redis (Celery broker/backend for background tasks) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Composio (managed auth + Outlook tools for the Relation/Mail agents) ---
COMPOSIO_API_KEY=
COMPOSIO_OUTLOOK_AUTH_CONFIG_ID=

# --- OpenAI (embeddings only, optional — for later RAG) ---
OPENAI_API_KEY=

# --- Anthropic (direct; optional — agents currently go via OpenRouter) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# --- EspoCRM (LEGACY — superseded by MongoDB; unused) ---
# ESPOCRM_BASE_URL=http://localhost:8080
# ESPOCRM_API_KEY=

# ---- Text-model provider (optional: self-hosted Gemma instead of OpenRouter) ----
# Leave ALL THREE unset to use OpenRouter (the default; nothing changes).
#
# To run every agent + extractor against a self-hosted OpenAI-compatible server:
#   1. open the tunnel and LEAVE IT RUNNING:
#        aws ssm start-session --profile govcloud --region us-gov-west-1 \
#          --target i-07a1cc9783d094ea4 \   # any SSM-online host in vpc-08975680ca2bdbb38
#          --document-name AWS-StartPortForwardingSessionToRemoteHost \
#          --parameters host="192.168.0.111",portNumber="8020",localPortNumber="8020"
#   2. set these, then verify with:  uv run python scripts/check_llm.py
#
# LLM_BASE_URL is relative to whatever RUNS THE BACKEND, not to your laptop:
#   backend on your laptop, tunnel on your laptop -> http://localhost:8020/v1
#   backend on the NJ server / Orionhub           -> the address THAT box reaches the
#                                                    model on (e.g. its Tailscale IP,
#                                                    http://100.x.y.z:8020/v1)
#   backend in a container, tunnel on the host    -> http://host.docker.internal:8020/v1
# LLM_BASE_URL=http://localhost:8020/v1
# LLM_API_KEY=local
# LLM_MODEL must be an id the server actually serves (check_llm.py prints the list).
# NOTE the instance id in the tunnel command above: i-034f6f635b06863bf (the one originally
# circulated) DOES NOT EXIST in us-gov-west-1. The jump host only needs to be SSM-online and
# in vpc-08975680ca2bdbb38, which carries the active 192.168.0.0/24 route over
# vpn-0c7c97138417da3be. Verified working: i-07a1cc9783d094ea4.
# LLM_MODEL=gemma4-31b    # verified served by the lab box (llama.cpp, 262k ctx)
#
# NOTE: image generation (IMAGE_GEN_MODEL) always uses OpenRouter — a text model cannot
# serve it — so OPENROUTER_API_KEY is still needed if the Capture agent generates images.

# Reasoning models (e.g. the lab box's gemma-4-31B) think before answering, and that thought
# is charged to the same token budget. OFF by default — measured on real extractions:
#   thinking off -> 6.0s   | thinking on -> 36.5s   (identical results)
# Turn it on only for judgement-heavy work. Ignored unless LLM_BASE_URL is set, because
# chat_template_kwargs is a llama.cpp extension and must not be sent to OpenRouter.
# LLM_ENABLE_THINKING=false
