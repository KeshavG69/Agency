# Collecct backend — copy to .env and fill in. Never commit .env.

# --- MongoDB (the CRM / pipeline source of truth) ---
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=collecct

# --- OpenRouter (agent model + Excel column-mapping LLM) ---  REQUIRED to ingest & run agents
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EXTRACTION_MODEL=google/gemini-3.1-flash-lite      # used by Excel ingestion
ANALYST_MODEL=anthropic/claude-sonnet-4.6          # used by the agents (via the cached LLM client)

# --- Exa (web search tool for agents) ---  REQUIRED for Analyst/Capture research
EXA_API_KEY=

# --- iDrive e2 (S3-compatible storage for generated documents) ---  REQUIRED for doc generation
IDRIVE_E2_ENDPOINT=
IDRIVE_E2_ACCESS_KEY=
IDRIVE_E2_SECRET_KEY=
IDRIVE_E2_BUCKET=

# --- Redis (Celery broker/backend for background tasks) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Composio (managed auth + Outlook tools for the Relation/Mail agents) ---
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=nexagen-bd
COMPOSIO_OUTLOOK_AUTH_CONFIG_ID=

# --- OpenAI (embeddings only, optional — for later RAG) ---
OPENAI_API_KEY=

# --- Anthropic (direct; optional — agents currently go via OpenRouter) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# --- EspoCRM (LEGACY — superseded by MongoDB; unused) ---
# ESPOCRM_BASE_URL=http://localhost:8080
# ESPOCRM_API_KEY=
