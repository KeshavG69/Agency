# ---- Collecct frontend env ----

# Backend API base URL (no trailing slash; callers add the full /api/... path).
# This is the BUILD-TIME default baked into the client bundle.
NEXT_PUBLIC_API_BASE=http://localhost:8000

# In Docker, you can override the backend URL at RUNTIME (no rebuild) by setting one of
# these on the container — the entrypoint writes it into /__env.js, which the app reads first:
#   API_BASE=https://your-backend.example.com
# (falls back to NEXT_PUBLIC_API_BASE, then http://localhost:8000)
